# Clerk publishable key for the frontend build/runtime
VITE_CLERK_PUBLISHABLE_KEY=<your_clerk_publishable_key>

# Base URL of the deployed monolith backend API (Render), including the /api suffix.
# Leave unset for local dev to fall back to http://<host>:5000/api
# Example: https://laztnote-backend.onrender.com/api
VITE_API_URL=
