# =============================================================================
# AlgoNote AI — Frontend environment variables
# Repo: lazynote_monolithic_frontend (deploy to Vercel)
# Copy to .env for local dev:  cp .env.example .env
# =============================================================================
#
# Vite only exposes variables prefixed with VITE_ to the browser.
# After changing env vars on Vercel, redeploy for changes to take effect.

# -----------------------------------------------------------------------------
# Clerk authentication (required)
# Must match CLERK_PUBLISHABLE_KEY on the backend.
# Get from: https://dashboard.clerk.com → API Keys → Publishable key
# Used by: src/main.jsx (ClerkProvider)
# -----------------------------------------------------------------------------

VITE_CLERK_PUBLISHABLE_KEY=pk_test_<your_clerk_publishable_key>

# -----------------------------------------------------------------------------
# Backend API URL (required in production)
# Used by:
# - src/services/api.js (axios baseURL for all /api/* calls)
# - src/services/renderWarmup.js (derives backend /health wake-up ping from this URL)
#
# Local dev: leave empty — Vite proxies /api → http://127.0.0.1:5000 (vite.config.js)
#            and falls back to http://<hostname>:5000/api when no proxy path is used.
#
# Production (Vercel + Render backend): set to your Render service URL
# with the /api suffix:
# VITE_API_URL=https://<your-render-service>.onrender.com/api
# (Warmup will call https://<your-render-service>.onrender.com/health)
# -----------------------------------------------------------------------------

VITE_API_URL=
